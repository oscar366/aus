[sub_resource type="GDScript" id="GDScript_0wfyh"]
resource_name = "cameraMovement"
script/source = "extends Camera2D

@export var speed: float = 500.0

func _process(delta: float) -> void:
	var direction = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")

	position += direction * speed * delta
"

[sub_resource type="GDScript" id="GDScript_sugp2"]
resource_name = "tilemap_debug_tools"
script/source = "extends Control

@onready var tile_map: TileMapLayer = $\"../../../TileMap\"

@onready var pos_label: Label = $Pos
@onready var alt_label: Label = $biomeValues/alt
@onready var heat_label: Label = $biomeValues/heat
@onready var humadty_label: Label = $biomeValues/humadty
@onready var soil_comp_label: Label = $biomeValues/soilComp
@onready var biome_label: Label = $biomeValues/biome

const worlds_gen = preload(\"res://scripts/world_gen.gd\")

var worldgen = worlds_gen.new()

func _ready() -> void:
	add_child(worldgen)
	pos_label.hide()
	alt_label.hide()
	heat_label.hide()
	humadty_label.hide()
	soil_comp_label.hide()
	biome_label.hide()
	pos_label.mouse_filter = Control.MOUSE_FILTER_IGNORE

func _process(_delta: float) -> void:
	if not is_instance_valid(tile_map):
		return

	var mouse_global = get_global_mouse_position()
	var mouse_local = tile_map.to_local(mouse_global)
	var tile_pos = tile_map.local_to_map(mouse_local)

	if tile_map.get_cell_source_id(tile_pos) == -1:
		pos_label.show()
		alt_label.show()
		heat_label.show()
		humadty_label.show()
		soil_comp_label.show()
		biome_label.show()
		return

	pos_label.text = \"Tile: %d, %d\" % [tile_pos.x, tile_pos.y]
	alt_label.text = \"ALT: \" + str(round(worldgen.get_altitude(tile_pos.x,tile_pos.y)*10))
	heat_label.text = \"HEAT: \" + str(round(worldgen.get_heat(tile_pos.x,tile_pos.y)*10))
	humadty_label.text = \"HUMADTY: \" + str(round(worldgen.get_humidity(tile_pos.x,tile_pos.y)*10))
	soil_comp_label.text = \"SOIL PUREATY: \" + str(round(worldgen.get_soilcomp(tile_pos.x,tile_pos.y)*10))
	biome_label.text = \"BIOME: \" + worldgen.get_biome(tile_pos.x,tile_pos.y)
	#pos_label.position = get_local_mouse_position() + Vector2(16, 16)
	pos_label.show()
	alt_label.show()
	heat_label.show()
	humadty_label.show()
	soil_comp_label.show()
	biome_label.show()
	
"

