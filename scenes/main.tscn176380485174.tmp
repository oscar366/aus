[sub_resource type="GDScript" id="GDScript_0wfyh"]
resource_name = "cameraMovement"
script/source = "extends Camera2D

@export var speed: float = 500.0

func _process(delta: float) -> void:
	var direction = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")

	position += direction * speed * delta
"

[sub_resource type="GDScript" id="GDScript_sugp2"]
resource_name = "tilemap_debug_tools"
script/source = "extends Control

const worlds_gen = preload(\"res://scripts/world_gen.gd\")

var worldgen = worlds_gen.new()

@onready var tile_map: TileMapLayer = $\"../../TileMap\"

@onready var pos_label: Label = $Pos
@onready var alt_label: Label = $biomeValues/alt
@onready var heat_label: Label = $biomeValues/heat
@onready var humadty_label: Label = $biomeValues/humadty
@onready var soil_comp_label: Label = $biomeValues/soilComp

func _process(_delta: float) -> void:
	var mouse_pos = tile_map.to_local(get_global_mouse_position())
	var tile_pos: Vector2i = tile_map.local_to_map(mouse_pos)
	pos_label.text = str(tile_pos.x) + \", \" + str(tile_pos.y)
	alt_label.text = str(worldgen.get_altitude(tile_pos.x, tile_pos.y))
	heat_label.text = str(worldgen.get_heat(tile_pos.x, tile_pos.y))
	humadty_label.text = str(worldgen.get_humidity(tile_pos.x, tile_pos.y))
	soil_comp_label.text = str(worldgen.get_soilcomp(tile_pos.x, tile_pos.y))
"

