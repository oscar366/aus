[sub_resource type="TileSet" id="TileSet_0y2sr"]
sources/0 = SubResource("TileSetAtlasSource_1yjpo")

[sub_resource type="GDScript" id="GDScript_glokq"]
script/source = "extends TileMap

const worlds_gen = preload(\"res://scripts/world_gen.gd\")

var world = worlds_gen.new()

func _ready() -> void:
	gen(0)

func gen(value) -> void:
	print(value)
	add_child(world)

	for x in range(world.Width):
		for y in range(world.Height):
			var _at_pos
			if value == 0:
				_at_pos = world.get_heat(x, y)
			elif value == 1:
				_at_pos = world.get_altitude(x, y)
			elif value == 2:
				_at_pos = world.get_humidity(x, y)

			if _at_pos < 0:
				set_cell(0, Vector2i(x, y), 0, Vector2i(1, 1))
			else:
				set_cell(0, Vector2i(x, y), 0, Vector2i(4, 2))

func _on_button_pressed() -> void:
	gen($\"../OptionButton\".selected)
"

