[sub_resource type="GDScript" id="GDScript_0wfyh"]
resource_name = "cameraMovement"
script/source = "extends Camera2D

@export var speed: float = 500.0

func _process(delta: float) -> void:
	var direction = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")

	position += direction * speed * delta
"

[sub_resource type="GDScript" id="GDScript_sugp2"]
resource_name = "tilemap_debug_tools"
script/source = "extends Control
@onready var tile_map: TileMapLayer = $\"../../../TileMap\"

@onready var tilemap_things: Control = $\".\"

func _ready() -> void:
	tilemap_things.hide()
	tilemap_things.mouse_filter = Control.MOUSE_FILTER_IGNORE

func _process(_delta: float) -> void:
	if not is_instance_valid(tile_map):
		tilemap_things.hide()
		return

	var mouse_pos = tile_map.to_local(get_global_mouse_position())
	var tile_pos = tile_map.local_to_map(mouse_pos)

	if tile_map.get_cell_source_id(tile_pos) == -1:
		tilemap_things.hide()
		return

	tilemap_things.text = \"Tile: %s, %s\" % [tile_pos.x, tile_pos.y]
	tilemap_things.global_position = get_global_mouse_position() + Vector2(16, 16)
	tilemap_things.show()
"

